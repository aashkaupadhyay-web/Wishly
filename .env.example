# ---- PUBLIC (shipped to the browser; safe by design) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---- PRIVATE (server only. NEVER prefix with NEXT_PUBLIC_, never commit) ----
SUPABASE_SERVICE_ROLE_KEY=
# Optional. Leave empty to run on the seeded catalog only.
SERPAPI_KEY=
# Master switch for live Google Shopping search. Must be "true" AND SERPAPI_KEY set.
ENABLE_SERPAPI=false
# Optional overrides (defaults shown)
# SERPAPI_MONTHLY_LIMIT=250
